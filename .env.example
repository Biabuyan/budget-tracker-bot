# ============================================
#  Budget Tracker Bot — Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Telegram ---
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-here

# --- PostgreSQL Database ---
# Railway provides this automatically when you add a Postgres database
DATABASE_URL=postgresql://user:password@host:port/dbname

# --- Google OAuth (Gmail API) ---
# Create at https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-railway-app.up.railway.app/auth/google/callback

# --- App Settings ---
# Public URL of this app (Railway gives you one, e.g. https://xxx.up.railway.app)
APP_BASE_URL=https://your-railway-app.up.railway.app

# Fernet encryption key for storing OAuth tokens at rest.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-here

# How often to check Gmail for new emails (minutes, default: 5)
EMAIL_CHECK_INTERVAL=5

# Port for the web server (Railway sets PORT automatically)
PORT=8080

# ============================================
#  Budget Tracker Bot — Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Telegram ---
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-here
# Get your chat ID from @userinfobot on Telegram
TELEGRAM_CHAT_ID=your-chat-id-here

# --- Email (IMAP) ---
EMAIL_ADDRESS=you@gmail.com
EMAIL_PASSWORD=your-app-password-here   # Gmail: use App Password, NOT your main password
IMAP_SERVER=imap.gmail.com              # Gmail default; Outlook: imap-mail.outlook.com
IMAP_PORT=993

# Sender address your bank uses for transaction emails
BANK_EMAIL_SENDER=alerts@yourbank.com

# How often to check for new emails (minutes)
EMAIL_CHECK_INTERVAL=5

# --- App Settings ---
# Default monthly budget (in your primary currency)
DEFAULT_MONTHLY_BUDGET=3000
# Fallback currency symbol (actual currency is auto-detected from emails when possible)
CURRENCY_SYMBOL=$
